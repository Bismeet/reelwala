# Local preview uses persistent embedded PostgreSQL and private disk uploads.
APP_ENV=preview
APP_ORIGIN=http://127.0.0.1:3000
BUSINESS_TIMEZONE=Asia/Kolkata
# Set DATABASE_URL to use a managed PostgreSQL database instead of PGlite.
# DATABASE_URL=
# SESSION_SECRET=generate-a-long-random-server-only-value
# Production remains gated until the documented business decisions are resolved.
RELEASE_APPROVED=false
NOTIFICATION_PROVIDER=outbox

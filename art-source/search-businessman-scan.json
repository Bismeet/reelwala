51b257c4683a9d52ecb832252eb.jpeg", "height": 144}, {"uid": "ff63d13435f546ffa0b7e396a6c13c21", "size": 870, "width": 64, "url": "https://media.sketchfab.com/models/247a92da6b064792ac4c70519315ae99/thumbnails/7c5bd8be54cf4dd8ae79f816b625a82b/a70afed20f8d48d68abda349561ef7ae.jpeg", "height": 36}]}, "user": {"uid": "0968291df4d942a9bdc919d59f6ee16c", "username": "hmane", "displayName": "Harvard Museum of the Ancient Near East", "profileUrl": "https://sketchfab.com/hmane", "account": "prem", "avatar": {"uri": "https://api.sketchfab.com/v3/avatars/83ce99194f354c50a79d88c7c765faf5", "images": [{"size": 3682, "width": 100, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/407785dfba1c45c98b5e1d276e63e4a2.jpeg", "height": 100}, {"size": 3136, "width": 90, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/3025330c1fa94a20a7655a7a44eba5e7.jpeg", "height": 90}, {"size": 1202, "width": 48, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/812f379b26d248bb9817db912bb98170.jpeg", "height": 48}, {"size": 758, "width": 32, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/dea785199cc84ad192641c55bf6aa710.jpeg", "height": 32}]}, "uri": "https://api.sketchfab.com/v3/users/0968291df4d942a9bdc919d59f6ee16c"}, "description": "Canopic jar of Userhat\nLimestone\nEgypt (Valley of the Kings, tomb KV 45)\nDynasty 18, reigns of Thutmose Ill to Amenhotep Ill, 1400\u20131352 BC\nGift of Theodore M. Davis \nHarvard Museum of the Ancient Near East 1902.50.1A\n\nCanopic jars held internal organs {lungs, liver, stomach, and intestines) from a mummified body, and came in sets of four. This beautifully carved jar was one of three excavated in the Valley of the Kings in 1902 by Egyptologist Howard Carter\u2014who later discovered Tutankhamun' s tomb\u2014and millionaire businessman Theodore M. Davis. In 2006, archaeologists discovered fragments of the fourth jar in a nearby tomb (KV 27). This jar is inscribed for \u201cUserhat, Overseer of the fields of Amun.\u201d He was one of the very few non-royal individuals to be buried in the Valley of the Kings. Carter found Userhat\u2019s tomb, which had been reused at a later period, choked with debris and damaged by flooding.\n\nLow resolution scan", "faceCount": 1087147, "createdAt": "2016-02-23T14:26:09.592535", "vertexCount": 599491, "isAgeRestricted": false, "archives": {"glb": {"textureCount": 0, "size": 42669304, "type": "glb", "textureMaxResolution": 0, "faceCount": 1087147, "vertexCount": 616920}, "gltf": {"textureCount": 0, "size": 18702270, "type": "gltf", "textureMaxResolution": 0, "faceCount": 1087147, "vertexCount": 616920}, "source": {"textureCount": null, "size": 13322479, "type": "source", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}, "usdz": {"textureCount": null, "size": 17437927, "type": "usdz", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}}, "license": {"uid": "322a749bcfa841b29dff1e8a1bb74b0b", "label": "CC Attribution"}}, {"uri": "https://api.sketchfab.com/v3/models/5a98051aae9740828a5fe967418a9b7a", "uid": "5a98051aae9740828a5fe967418a9b7a", "name": "Alice Maria Paxton Cooper Obelisk", "staffpickedAt": null, "viewCount": 616, "likeCount": 18, "animationCount": 0, "viewerUrl": "https://sketchfab.com/3d-models/none-5a98051aae9740828a5fe967418a9b7a", "embedUrl": "https://sketchfab.com/models/5a98051aae9740828a5fe967418a9b7a/embed", "commentCount": 2, "isDownloadable": true, "publishedAt": "2015-04-13T21:40:04", "tags": [{"name": "tombstone", "slug": "tombstone", "uri": "https://api.sketchfab.com/v3/tags/tombstone"}, {"name": "cemetery", "slug": "cemetery", "uri": "https://api.sketchfab.com/v3/tags/cemetery"}, {"name": "evergreen", "slug": "evergreen", "uri": "https://api.sketchfab.com/v3/tags/evergreen"}, {"name": "mah", "slug": "mah", "uri": "https://api.sketchfab.com/v3/tags/mah"}, {"name": "obelisk", "slug": "obelisk", "uri": "https://api.sketchfab.com/v3/tags/obelisk"}, {"name": "santa_cruz", "slug": "santa_cruz", "uri": "https://api.sketchfab.com/v3/tags/santa_cruz"}, {"name": "agisoft", "slug": "agisoft", "uri": "https://api.sketchfab.com/v3/tags/agisoft"}, {"name": "photoscan", "slug": "photoscan", "uri": "https://api.sketchfab.com/v3/tags/photoscan"}], "categories": [], "thumbnails": {"images": [{"uid": "e4536d58bc234a64a59607857763c2b4", "size": 128111, "width": 1920, "url": "https://media.sketchfab.com/models/5a98051aae9740828a5fe967418a9b7a/thumbnails/bf357e4499774089a4a6d2d325039368/1920x1080.jpeg", "height": 1080}, {"uid": "8c393d364f63433fab621d7e3c322bb9", "size": 35683, "width": 1024, "url": "https://media.sketchfab.com/models/5a98051aae9740828a5fe967418a9b7a/thumbnails/bf357e4499774089a4a6d2d325039368/1024x576.jpeg", "height": 576}, {"uid": "f1910ca6f7744a4cab44caf816e49c52", "size": 20196, "width": 720, "url": "https://media.sketchfab.com/models/5a98051aae9740828a5fe967418a9b7a/thumbnails/bf357e4499774089a4a6d2d325039368/720x405.jpeg", "height": 405}, {"uid": "d6af2faa115c4726b6b63acb2d58612c", "size": 4377, "width": 256, "url": "https://media.sketchfab.com/models/5a98051aae9740828a5fe967418a9b7a/thumbnails/bf357e4499774089a4a6d2d325039368/256x144.jpeg", "height": 144}, {"uid": "0d694d87cb1340aaad7d404248d626fb", "size": 1107, "width": 64, "url": "https://media.sketchfab.com/models/5a98051aae9740828a5fe967418a9b7a/thumbnails/bf357e4499774089a4a6d2d325039368/64x36.jpeg", "height": 36}]}, "user": {"uid": "1f255561fefc4f40bce69652b519ad1c", "username": "santacruzmah", "displayName": "Santa Cruz Museum of Art and History", "profileUrl": "https://sketchfab.com/santacruzmah", "account": "pro", "avatar": {"uri": "https://api.sketchfab.com/v3/avatars/dc1a12009e3b40568cdf5614952f68fa", "images": [{"size": 856, "width": 32, "url": "https://media.sketchfab.com/avatars/dc1a12009e3b40568cdf5614952f68fa/d3611687a09749fcacbefe04c5dc4d72.jpeg", "height": 32}, {"size": 1345, "width": 48, "url": "https://media.sketchfab.com/avatars/dc1a12009e3b40568cdf5614952f68fa/8d9944de5e4a4b099cd19ea338332d26.jpeg", "height": 48}, {"size": 2762, "width": 90, "url": "https://media.sketchfab.com/avatars/dc1a12009e3b40568cdf5614952f68fa/1ce2bf5c23e84bd59b16143ebcd77fac.jpeg", "height": 90}, {"size": 3151, "width": 100, "url": "https://media.sketchfab.com/avatars/dc1a12009e3b40568cdf5614952f68fa/91c2d41b4281417ebf3b91de5265cd09.jpeg", "height": 100}]}, "uri": "https://api.sketchfab.com/v3/users/1f255561fefc4f40bce69652b519ad1c"}, "description": "Originally from Pennsylvania, Alice Cooper married John L. Cooper in the 1850s. Sources vary on the specifics. John Cooper's diary (via Archivegrid) indicates that they married on the East Coast in 1852, and the Sacramento Daily Union newspaper that they married in Santa Cruz on July 4, 1859. Without a scan or physical copy of the diary pages, it may be supposed that \"1852\" is an error in transcription, and that 1859 was the actual year of marriage.\r\n\r\nWhile little information on Alice is available, John L. Cooper was a prominent businessman in Santa Cruz. He moved west from PA in 1849. He was the Santa Cruz County Supervisor for many years. He and his brother William, who became the city's first mayor in 1876, gave land for the first county courthouse to be built.\r\n\r\nhttp://beta.worldcat.org/archivegrid/collection/data/237007870\r\nhttp://cdnc.ucr.edu/cgi-bin/cdnc?a=d&d=SDU18590830.2.12.1&e=-------en--20--1--txt-txIN------#\r\nhttp://www.santacruzmah.org/wp-content/uploads/2014/03/Cooper-Family.pdf", "faceCount": 179999, "createdAt": "2015-04-13T21:39:42", "vertexCount": 90273, "isAgeRestricted": false, "archives": {"glb": {"textureCount": 1, "size": 9177380, "type": "glb", "textureMaxResolution": 4096, "faceCount": 179999, "vertexCount": 111010}, "gltf": {"textureCount": 1, "size": 6973452, "type": "gltf", "textureMaxResolution": 4096, "faceCount": 179999, "vertexCount": 111010}, "source": {"textureCount": null, "size": 7039087, 
sketchfab.com/models/bcc74997c6124a8fa744d448e96deb20/thumbnails/3ae46d4c220e4424ae7d093ac8f63004/cba37fb0c2c742218c5e13c4a18ba935.jpeg", "height": 405}, {"uid": "410613fe6fa74c41bde7915b16f80955", "size": 2894, "width": 256, "url": "https://media.sketchfab.com/models/bcc74997c6124a8fa744d448e96deb20/thumbnails/3ae46d4c220e4424ae7d093ac8f63004/c5c7237eb1a7436a82cdb5639f0e71c8.jpeg", "height": 144}, {"uid": "c03039a1a9ed49f08456db91afd2ff16", "size": 665, "width": 64, "url": "https://media.sketchfab.com/models/bcc74997c6124a8fa744d448e96deb20/thumbnails/3ae46d4c220e4424ae7d093ac8f63004/4430e2aeaf7440e9a9adea756f533bd0.jpeg", "height": 36}]}, "user": {"uid": "0968291df4d942a9bdc919d59f6ee16c", "username": "hmane", "displayName": "Harvard Museum of the Ancient Near East", "profileUrl": "https://sketchfab.com/hmane", "account": "prem", "avatar": {"uri": "https://api.sketchfab.com/v3/avatars/83ce99194f354c50a79d88c7c765faf5", "images": [{"size": 3682, "width": 100, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/407785dfba1c45c98b5e1d276e63e4a2.jpeg", "height": 100}, {"size": 3136, "width": 90, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/3025330c1fa94a20a7655a7a44eba5e7.jpeg", "height": 90}, {"size": 1202, "width": 48, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/812f379b26d248bb9817db912bb98170.jpeg", "height": 48}, {"size": 758, "width": 32, "url": "https://media.sketchfab.com/avatars/83ce99194f354c50a79d88c7c765faf5/dea785199cc84ad192641c55bf6aa710.jpeg", "height": 32}]}, "uri": "https://api.sketchfab.com/v3/users/0968291df4d942a9bdc919d59f6ee16c"}, "description": "Egypt\n\nValley of the Kings, tomb of Userhat, KV 45\n\nDynasty 18, reigns of Thutmose III to Amenhotep III, 1400\u20131352 BC \n\nLimestone \n\nGift of Theodore M. Davis\n\nHarvard Museum of the Ancient Near East 1902.50.2  \n\n(set: 1902.50.1A/B, 1902.50.2, 1902.50.3)\n\nCanopic jars held the internal organs from the mummified body, and came in sets of four. This jar lid was one of three excavated in the Valley of the Kings in 1902 by Egyptologist Howard Carter\u2014who later discovered Tutankhamun\u2019s tomb\u2014and millionaire businessman Theodore M. Davis. In 2006, archaeologists discovered fragments of the fourth jar in a nearby tomb (KV 27). The jar itself (on view up on the second floor) is inscribed for \u201cUserhat, Overseer of the fields of Amun.\u201d\n\nKV 45 is located in the southeast branch of the main wadi, close to KV 44. The well-cut tomb consists of a shaft (A) and a small chamber (B). The tomb was found undecorated.\n\n\n*Scanned by Andr\u00e9a Martinez with the Artec Space Spider*", "faceCount": 2071930, "createdAt": "2019-02-01T21:41:54.236274", "vertexCount": 1035951, "isAgeRestricted": false, "archives": {"glb": {"textureCount": 1, "size": 95103176, "type": "glb", "textureMaxResolution": 8192, "faceCount": 2071930, "vertexCount": 1176743}, "gltf": {"textureCount": 1, "size": 71548454, "type": "gltf", "textureMaxResolution": 8192, "faceCount": 2071930, "vertexCount": 1176743}, "source": {"textureCount": null, "size": 185238309, "type": "source", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}, "usdz": {"textureCount": null, "size": 46323366, "type": "usdz", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}}, "license": {"uid": "322a749bcfa841b29dff1e8a1bb74b0b", "label": "CC Attribution"}}, {"uri": "https://api.sketchfab.com/v3/models/8612837c21794a9a9a4fcb9ea931e9db", "uid": "8612837c21794a9a9a4fcb9ea931e9db", "name": "Rubik's Cube - point cloud - polycam scan", "staffpickedAt": null, "viewCount": 536, "likeCount": 0, "animationCount": 0, "viewerUrl": "https://sketchfab.com/3d-models/none-8612837c21794a9a9a4fcb9ea931e9db", "embedUrl": "https://sketchfab.com/models/8612837c21794a9a9a4fcb9ea931e9db/embed", "commentCount": 0, "isDownloadable": true, "publishedAt": "2022-01-22T17:35:25.724744", "tags": [{"name"
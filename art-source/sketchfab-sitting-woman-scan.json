t": 32}, {"size": 2795, "width": 48, "url": "https://media.sketchfab.com/avatars/d1d2fff36f684b5693cd203e70b6d384/d4a13e27f1324309bda0fc25e8879ab8.png", "height": 48}, {"size": 6081, "width": 90, "url": "https://media.sketchfab.com/avatars/d1d2fff36f684b5693cd203e70b6d384/b73a08b1e8014334b5a31b07ff9a60d3.png", "height": 90}, {"size": 6914, "width": 100, "url": "https://media.sketchfab.com/avatars/d1d2fff36f684b5693cd203e70b6d384/4a01dd214a1a4cd380b55cec47e48544.png", "height": 100}]}, "uri": "https://api.sketchfab.com/v3/users/800b241d90c54a068bb5ecaff926ebb9"}, "description": "Lekythos\n\nCreated circa 375\u2013350 BCE\n\nPentelic marble\n\n18 1/4 x 9 3/4 x 9 3/4 inches\n\nAncient Greek\n\nThis lekythos features an engraving of a man and a woman. The inscription lists their names. The man sitting in the chair is Polyarchos. The woman shaking his hand is Polyxena. Their relationship to one another is unknown. The handshake depicted on this lekythos had a special meaning in ancient Greece. The Greeks referred to a handshake as dexiosis, or \u201cengagement of the right hand.\u201d\n\nhttps://learn.ncartmuseum.org/artwork/lekythos/\n\n**FOR 3D PRINTING: [GO TO THINGIVERSE TO DOWNLOAD .STL FILES](https://www.thingiverse.com/thing:6182466)**\n\n**Download the [Zappar app](https://www.zappar.com/getzappar/); Then scan this code using the app:**\n\n![](https://www.ncmaexplore.levrstudios.com/greece/zapcodes/Greece_-_Leykthos-Greece_-_Leykthos.jpg)", "faceCount": 38080, "createdAt": "2023-06-26T18:58:03.531263", "vertexCount": 19042, "isAgeRestricted": false, "archives": {"glb": {"textureCount": 2, "size": 17549504, "type": "glb", "textureMaxResolution": 4096, "faceCount": 38080, "vertexCount": 19491}, "gltf": {"textureCount": 2, "size": 16970943, "type": "gltf", "textureMaxResolution": 4096, "faceCount": 38080, "vertexCount": 19491}, "gltf-ar": {"textureCount": null, "size": 4768, "type": "gltf-ar", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}, "s